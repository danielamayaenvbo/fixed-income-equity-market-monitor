# Copy this file to .env and replace every placeholder with your own value.
FRED_API_KEY=replace_with_your_fred_api_key
FINNHUB_API_KEY=replace_with_your_finnhub_api_key

# Local PostgreSQL settings used by Docker Compose and Alembic.
POSTGRES_DB=market_monitor
POSTGRES_USER=market_monitor
POSTGRES_PASSWORD=market_monitor_dev
DATABASE_URL=postgresql+psycopg://market_monitor:market_monitor_dev@localhost:5432/market_monitor
